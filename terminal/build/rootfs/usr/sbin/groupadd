#!/bin/sh
# BusyBox has addgroup instead of groupadd. Supports -g GID.
usage() { echo "Usage: groupadd [-g GID] GROUP" >&2; exit 2; }
gid=
while getopts "g:" opt; do
  case $opt in
    g) gid=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage
if [ "$(id -u)" -ne 0 ]; then
  echo "groupadd: Permission denied." >&2
  exit 1
fi
if [ -n "$gid" ]; then exec addgroup -g "$gid" "$1"; else exec addgroup "$1"; fi
