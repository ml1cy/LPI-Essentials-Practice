# Kernel options layered on top of `make ARCH=i386 tinyconfig`.
# Goal: the smallest kernel that boots fast in v86 and gives a realistic
# single-machine Linux: users and permissions, /proc, tmpfs, a clock, dmesg.

# CPU and timing
CONFIG_M686=y
CONFIG_NOHIGHMEM=y
CONFIG_HZ_100=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# Boot from an initramfs, run ELF binaries and #! scripts
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Serial console (ttyS0) and a second port (ttyS1) for terminal resizes
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2

# What the userland expects from a normal Linux system
CONFIG_MULTIUSER=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
# glibc on 32-bit x86 still uses some 32-bit time_t system calls (touch needs them)
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_ADVISE_SYSCALLS=y

# Serial only: no virtual consoles or input drivers
# CONFIG_VT is not set
# CONFIG_INPUT is not set
