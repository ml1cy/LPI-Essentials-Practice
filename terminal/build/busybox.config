# BusyBox options layered on top of `make defconfig`.

# One static 32-bit binary
CONFIG_STATIC=y
CONFIG_EXTRA_CFLAGS="-m32 -march=i686"
CONFIG_EXTRA_LDFLAGS="-m32"

# Handle /etc/passwd, /etc/shadow and password hashing without glibc NSS/libcrypt
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y

# The exam's scripts use bash: let `bash` and #!/bin/bash run BusyBox's shell
CONFIG_BASH_IS_ASH=y
# CONFIG_BASH_IS_NONE is not set

# su and passwd need the setuid bit to work for a regular user
CONFIG_FEATURE_SUID=y

# Doesn't build against Linux 6.8 headers (CBQ was removed), and there's no network anyway
# CONFIG_TC is not set
